# Ambiente local. Copie para .env e use uma senha exclusiva para desenvolvimento.
POSTGRES_DB=delivery_mhs
POSTGRES_USER=delivery_mhs
POSTGRES_PASSWORD=troque-por-uma-senha-local-segura
POSTGRES_PORT=5432
DATABASE_URL=postgresql://delivery_mhs:troque-por-uma-senha-local-segura@127.0.0.1:5432/delivery_mhs

# Somente demonstração com dados fictícios. Nunca habilitar para dados reais.
ADMIN_ENABLED=false
# Origem exata do aplicativo; em produção use HTTPS.
APP_ORIGIN=http://127.0.0.1:3000
